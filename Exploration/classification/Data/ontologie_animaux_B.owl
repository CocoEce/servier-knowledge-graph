<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns="http://example.org/animal-taxonomy-B#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:base="http://example.org/animal-taxonomy-B">
  <owl:Ontology rdf:about="http://example.org/animal-taxonomy-B">
    <owl:versionInfo>1.0</owl:versionInfo>
    <dc:title>Zoological Classification System B</dc:title>
    <dc:description>A comprehensive taxonomy for animal kingdom classification and study</dc:description>
    <dc:created>2026-01-22T11:47:52.892573</dc:created>
  </owl:Ontology>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/AnimalOrganism">
    <rdfs:label xml:lang="en">Animal Organism</rdfs:label>
    <rdfs:comment xml:lang="en">Living creature that consumes organic material and typically has mobility and sensory capabilities</rdfs:comment>
    <skos:altLabel xml:lang="en">Creature</skos:altLabel>
    <skos:altLabel xml:lang="en">Beast</skos:altLabel>
    <skos:altLabel xml:lang="en">Living Animal</skos:altLabel>
    <rdfs:comment>kingdom: Animalia</rdfs:comment>
    <rdfs:comment>type: base_class</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/Mammalian">
    <rdfs:label xml:lang="en">Mammalian</rdfs:label>
    <rdfs:comment xml:lang="en">Endothermic vertebrate distinguished by fur, mammary glands, and live birth</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/AnimalOrganism"/>
    <skos:altLabel xml:lang="en">Mammal Class</skos:altLabel>
    <skos:altLabel xml:lang="en">Mammalia</skos:altLabel>
    <skos:altLabel xml:lang="en">Warm-blooded Animal</skos:altLabel>
    <rdfs:comment>class: Mammalia</rdfs:comment>
    <rdfs:comment>temperature_regulation: endothermic</rdfs:comment>
    <rdfs:comment>offspring: live_birth</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/CarnivorousMammal">
    <rdfs:label xml:lang="en">Carnivorous Mammal</rdfs:label>
    <rdfs:comment xml:lang="en">Flesh-eating mammal with adaptations for hunting</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/Mammalian"/>
    <skos:altLabel xml:lang="en">Predator</skos:altLabel>
    <skos:altLabel xml:lang="en">Carnivora Order</skos:altLabel>
    <skos:altLabel xml:lang="en">Hunter</skos:altLabel>
    <rdfs:comment>order: Carnivora</rdfs:comment>
    <rdfs:comment>feeding_type: carnivorous</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/FelidFamily">
    <rdfs:label xml:lang="en">Felid Family</rdfs:label>
    <rdfs:comment xml:lang="en">Carnivorous mammals of the cat family with retractable claws</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/CarnivorousMammal"/>
    <skos:altLabel xml:lang="en">Cat</skos:altLabel>
    <skos:altLabel xml:lang="en">Feline</skos:altLabel>
    <skos:altLabel xml:lang="en">Felidae Family</skos:altLabel>
    <rdfs:comment>family: Felidae</rdfs:comment>
    <rdfs:comment>claw_type: retractable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/AfricanLion">
    <rdfs:label xml:lang="en">African Lion</rdfs:label>
    <rdfs:comment xml:lang="en">Large social cat with distinctive mane in males</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/FelidFamily"/>
    <skos:altLabel xml:lang="en">Lion</skos:altLabel>
    <skos:altLabel xml:lang="en">Panthera leo</skos:altLabel>
    <skos:altLabel xml:lang="en">Savanna Lion</skos:altLabel>
    <rdfs:comment>species: Panthera leo</rdfs:comment>
    <rdfs:comment>environment: grassland</rdfs:comment>
    <rdfs:comment>status: vulnerable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/TigerSpecies">
    <rdfs:label xml:lang="en">Tiger Species</rdfs:label>
    <rdfs:comment xml:lang="en">Largest feline with orange fur and black striping pattern</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/FelidFamily"/>
    <skos:altLabel xml:lang="en">Tiger</skos:altLabel>
    <skos:altLabel xml:lang="en">Panthera tigris</skos:altLabel>
    <skos:altLabel xml:lang="en">Striped Predator</skos:altLabel>
    <rdfs:comment>species: Panthera tigris</rdfs:comment>
    <rdfs:comment>environment: jungle</rdfs:comment>
    <rdfs:comment>status: endangered</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/SpottedLeopard">
    <rdfs:label xml:lang="en">Spotted Leopard</rdfs:label>
    <rdfs:comment xml:lang="en">Solitary big cat with rosette-patterned coat</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/FelidFamily"/>
    <skos:altLabel xml:lang="en">Leopard</skos:altLabel>
    <skos:altLabel xml:lang="en">Panthera pardus</skos:altLabel>
    <skos:altLabel xml:lang="en">Black Panther</skos:altLabel>
    <rdfs:comment>species: Panthera pardus</rdfs:comment>
    <rdfs:comment>environment: diverse</rdfs:comment>
    <rdfs:comment>status: vulnerable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/FastCheetah">
    <rdfs:label xml:lang="en">Fast Cheetah</rdfs:label>
    <rdfs:comment xml:lang="en">Speediest terrestrial animal with characteristic tear streaks</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/FelidFamily"/>
    <skos:altLabel xml:lang="en">Cheetah</skos:altLabel>
    <skos:altLabel xml:lang="en">Acinonyx jubatus</skos:altLabel>
    <skos:altLabel xml:lang="en">Sprint Cat</skos:altLabel>
    <rdfs:comment>species: Acinonyx jubatus</rdfs:comment>
    <rdfs:comment>environment: open_plains</rdfs:comment>
    <rdfs:comment>velocity: 120 km/h</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/HouseCat">
    <rdfs:label xml:lang="en">House Cat</rdfs:label>
    <rdfs:comment xml:lang="en">Small tamed feline commonly kept as companion animal</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/FelidFamily"/>
    <skos:altLabel xml:lang="en">Domestic Cat</skos:altLabel>
    <skos:altLabel xml:lang="en">Felis catus</skos:altLabel>
    <skos:altLabel xml:lang="en">Pet Feline</skos:altLabel>
    <rdfs:comment>species: Felis catus</rdfs:comment>
    <rdfs:comment>environment: human_dwelling</rdfs:comment>
    <rdfs:comment>domestication: yes</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/CanidGroup">
    <rdfs:label xml:lang="en">Canid Group</rdfs:label>
    <rdfs:comment xml:lang="en">Family of carnivorous mammals including wolves, dogs, and foxes</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/CarnivorousMammal"/>
    <skos:altLabel xml:lang="en">Dog Family</skos:altLabel>
    <skos:altLabel xml:lang="en">Canidae</skos:altLabel>
    <skos:altLabel xml:lang="en">Canine Group</skos:altLabel>
    <rdfs:comment>family: Canidae</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/GreyWolf">
    <rdfs:label xml:lang="en">Grey Wolf</rdfs:label>
    <rdfs:comment xml:lang="en">Large wild canid living in hierarchical packs</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/CanidGroup"/>
    <skos:altLabel xml:lang="en">Wolf</skos:altLabel>
    <skos:altLabel xml:lang="en">Canis lupus</skos:altLabel>
    <skos:altLabel xml:lang="en">Timber Wolf</skos:altLabel>
    <rdfs:comment>species: Canis lupus</rdfs:comment>
    <rdfs:comment>environment: wilderness</rdfs:comment>
    <rdfs:comment>behavior: pack_hunter</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/DomesticDog">
    <rdfs:label xml:lang="en">Domestic Dog</rdfs:label>
    <rdfs:comment xml:lang="en">Tamed canine descended from wolves, human companion</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/CanidGroup"/>
    <skos:altLabel xml:lang="en">Dog</skos:altLabel>
    <skos:altLabel xml:lang="en">Canis familiaris</skos:altLabel>
    <skos:altLabel xml:lang="en">Pet Dog</skos:altLabel>
    <rdfs:comment>species: Canis familiaris</rdfs:comment>
    <rdfs:comment>environment: domestic</rdfs:comment>
    <rdfs:comment>domestication: yes</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/RedFox">
    <rdfs:label xml:lang="en">Red Fox</rdfs:label>
    <rdfs:comment xml:lang="en">Small omnivorous canid with characteristic bushy tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/CanidGroup"/>
    <skos:altLabel xml:lang="en">Fox</skos:altLabel>
    <skos:altLabel xml:lang="en">Vulpes vulpes</skos:altLabel>
    <skos:altLabel xml:lang="en">Common Fox</skos:altLabel>
    <rdfs:comment>species: Vulpes vulpes</rdfs:comment>
    <rdfs:comment>environment: adaptable</rdfs:comment>
    <rdfs:comment>feeding: omnivorous</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/BearFamily">
    <rdfs:label xml:lang="en">Bear Family</rdfs:label>
    <rdfs:comment xml:lang="en">Large carnivorous or omnivorous mammals with heavy build</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/CarnivorousMammal"/>
    <skos:altLabel xml:lang="en">Ursidae</skos:altLabel>
    <skos:altLabel xml:lang="en">Bears</skos:altLabel>
    <skos:altLabel xml:lang="en">Ursine</skos:altLabel>
    <rdfs:comment>family: Ursidae</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/GrizzlyBear">
    <rdfs:label xml:lang="en">Grizzly Bear</rdfs:label>
    <rdfs:comment xml:lang="en">Large brown bear inhabiting North America and Eurasia</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/BearFamily"/>
    <skos:altLabel xml:lang="en">Brown Bear</skos:altLabel>
    <skos:altLabel xml:lang="en">Ursus arctos</skos:altLabel>
    <skos:altLabel xml:lang="en">Kodiak</skos:altLabel>
    <rdfs:comment>species: Ursus arctos</rdfs:comment>
    <rdfs:comment>environment: temperate_forest</rdfs:comment>
    <rdfs:comment>mass: large</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/ArcticBear">
    <rdfs:label xml:lang="en">Arctic Bear</rdfs:label>
    <rdfs:comment xml:lang="en">Large white-furred bear adapted to polar environment</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/BearFamily"/>
    <skos:altLabel xml:lang="en">Polar Bear</skos:altLabel>
    <skos:altLabel xml:lang="en">Ursus maritimus</skos:altLabel>
    <skos:altLabel xml:lang="en">White Bear</skos:altLabel>
    <rdfs:comment>species: Ursus maritimus</rdfs:comment>
    <rdfs:comment>environment: polar</rdfs:comment>
    <rdfs:comment>status: vulnerable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/PrimateOrder">
    <rdfs:label xml:lang="en">Primate Order</rdfs:label>
    <rdfs:comment xml:lang="en">Mammals including apes, monkeys, lemurs, and humans</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/Mammalian"/>
    <skos:altLabel xml:lang="en">Primate</skos:altLabel>
    <skos:altLabel xml:lang="en">Primates</skos:altLabel>
    <skos:altLabel xml:lang="en">Simians</skos:altLabel>
    <rdfs:comment>order: Primates</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/GreatApe">
    <rdfs:label xml:lang="en">Great Ape</rdfs:label>
    <rdfs:comment xml:lang="en">Large tailless primates with advanced cognitive abilities</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/PrimateOrder"/>
    <skos:altLabel xml:lang="en">Ape</skos:altLabel>
    <skos:altLabel xml:lang="en">Hominoid</skos:altLabel>
    <skos:altLabel xml:lang="en">Large Primate</skos:altLabel>
    <rdfs:comment>superfamily: Hominoidea</rdfs:comment>
    <rdfs:comment>tail_present: no</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/MountainGorilla">
    <rdfs:label xml:lang="en">Mountain Gorilla</rdfs:label>
    <rdfs:comment xml:lang="en">Largest primate species inhabiting African mountain forests</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/GreatApe"/>
    <skos:altLabel xml:lang="en">Gorilla</skos:altLabel>
    <skos:altLabel xml:lang="en">Gorilla beringei</skos:altLabel>
    <skos:altLabel xml:lang="en">Silverback Gorilla</skos:altLabel>
    <rdfs:comment>species: Gorilla beringei</rdfs:comment>
    <rdfs:comment>environment: mountain_forest</rdfs:comment>
    <rdfs:comment>status: endangered</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/CommonChimpanzee">
    <rdfs:label xml:lang="en">Common Chimpanzee</rdfs:label>
    <rdfs:comment xml:lang="en">Highly intelligent ape closely related to humans</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/GreatApe"/>
    <skos:altLabel xml:lang="en">Chimpanzee</skos:altLabel>
    <skos:altLabel xml:lang="en">Pan troglodytes</skos:altLabel>
    <skos:altLabel xml:lang="en">Chimp</skos:altLabel>
    <rdfs:comment>species: Pan troglodytes</rdfs:comment>
    <rdfs:comment>environment: tropical_forest</rdfs:comment>
    <rdfs:comment>cognition: advanced</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/BorneanOrangutan">
    <rdfs:label xml:lang="en">Bornean Orangutan</rdfs:label>
    <rdfs:comment xml:lang="en">Large reddish arboreal ape from Southeast Asia</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/GreatApe"/>
    <skos:altLabel xml:lang="en">Orangutan</skos:altLabel>
    <skos:altLabel xml:lang="en">Pongo pygmaeus</skos:altLabel>
    <skos:altLabel xml:lang="en">Forest Man</skos:altLabel>
    <rdfs:comment>species: Pongo pygmaeus</rdfs:comment>
    <rdfs:comment>environment: tropical_rainforest</rdfs:comment>
    <rdfs:comment>status: critically_endangered</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/TailedMonkey">
    <rdfs:label xml:lang="en">Tailed Monkey</rdfs:label>
    <rdfs:comment xml:lang="en">Smaller primates characterized by presence of tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/PrimateOrder"/>
    <skos:altLabel xml:lang="en">Monkey</skos:altLabel>
    <skos:altLabel xml:lang="en">Simian</skos:altLabel>
    <skos:altLabel xml:lang="en">Old World Monkey</skos:altLabel>
    <rdfs:comment>tail_present: yes</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/RodentOrder">
    <rdfs:label xml:lang="en">Rodent Order</rdfs:label>
    <rdfs:comment xml:lang="en">Small mammal with chisel-like incisors that grow continuously</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/Mammalian"/>
    <skos:altLabel xml:lang="en">Rodent</skos:altLabel>
    <skos:altLabel xml:lang="en">Rodentia</skos:altLabel>
    <skos:altLabel xml:lang="en">Gnawer</skos:altLabel>
    <rdfs:comment>order: Rodentia</rdfs:comment>
    <rdfs:comment>dentition: ever_growing_incisors</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/SmallMouse">
    <rdfs:label xml:lang="en">Small Mouse</rdfs:label>
    <rdfs:comment xml:lang="en">Tiny rodent with pointed nose and long slender tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/RodentOrder"/>
    <skos:altLabel xml:lang="en">Mouse</skos:altLabel>
    <skos:altLabel xml:lang="en">Mus musculus</skos:altLabel>
    <skos:altLabel xml:lang="en">Common Mouse</skos:altLabel>
    <rdfs:comment>species: Mus musculus</rdfs:comment>
    <rdfs:comment>body_size: tiny</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/LargeRat">
    <rdfs:label xml:lang="en">Large Rat</rdfs:label>
    <rdfs:comment xml:lang="en">Medium-sized rodent with robust body and scaly tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/RodentOrder"/>
    <skos:altLabel xml:lang="en">Rat</skos:altLabel>
    <skos:altLabel xml:lang="en">Rattus norvegicus</skos:altLabel>
    <skos:altLabel xml:lang="en">Sewer Rat</skos:altLabel>
    <rdfs:comment>species: Rattus norvegicus</rdfs:comment>
    <rdfs:comment>body_size: moderate</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/TreeSquirrel">
    <rdfs:label xml:lang="en">Tree Squirrel</rdfs:label>
    <rdfs:comment xml:lang="en">Bushy-tailed arboreal rodent with climbing abilities</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/RodentOrder"/>
    <skos:altLabel xml:lang="en">Squirrel</skos:altLabel>
    <skos:altLabel xml:lang="en">Sciurus vulgaris</skos:altLabel>
    <skos:altLabel xml:lang="en">Red Squirrel</skos:altLabel>
    <rdfs:comment>family: Sciuridae</rdfs:comment>
    <rdfs:comment>lifestyle: arboreal</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/MarineMammal">
    <rdfs:label xml:lang="en">Marine Mammal</rdfs:label>
    <rdfs:comment xml:lang="en">Aquatic or semi-aquatic mammals including whales and dolphins</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/Mammalian"/>
    <skos:altLabel xml:lang="en">Cetacean</skos:altLabel>
    <skos:altLabel xml:lang="en">Cetacea</skos:altLabel>
    <skos:altLabel xml:lang="en">Sea Mammal</skos:altLabel>
    <rdfs:comment>order: Cetacea</rdfs:comment>
    <rdfs:comment>environment: aquatic</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/BottlenoseDolphin">
    <rdfs:label xml:lang="en">Bottlenose Dolphin</rdfs:label>
    <rdfs:comment xml:lang="en">Smart marine mammal with distinctive bottle-shaped snout</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/MarineMammal"/>
    <skos:altLabel xml:lang="en">Dolphin</skos:altLabel>
    <skos:altLabel xml:lang="en">Tursiops</skos:altLabel>
    <skos:altLabel xml:lang="en">Common Dolphin</skos:altLabel>
    <rdfs:comment>genus: Tursiops</rdfs:comment>
    <rdfs:comment>cognition: advanced</rdfs:comment>
    <rdfs:comment>sonar: present</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/GiantWhale">
    <rdfs:label xml:lang="en">Giant Whale</rdfs:label>
    <rdfs:comment xml:lang="en">Enormous marine mammal, largest animals on Earth</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/MarineMammal"/>
    <skos:altLabel xml:lang="en">Whale</skos:altLabel>
    <skos:altLabel xml:lang="en">Cetacean</skos:altLabel>
    <skos:altLabel xml:lang="en">Baleen Whale</skos:altLabel>
    <rdfs:comment>body_size: enormous</rdfs:comment>
    <rdfs:comment>environment: pelagic</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/AvianClass">
    <rdfs:label xml:lang="en">Avian Class</rdfs:label>
    <rdfs:comment xml:lang="en">Warm-blooded vertebrates with feathers, beaks, and wings</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/AnimalOrganism"/>
    <skos:altLabel xml:lang="en">Bird</skos:altLabel>
    <skos:altLabel xml:lang="en">Aves</skos:altLabel>
    <skos:altLabel xml:lang="en">Flying Vertebrate</skos:altLabel>
    <rdfs:comment>class: Aves</rdfs:comment>
    <rdfs:comment>covering: feathers</rdfs:comment>
    <rdfs:comment>egg_laying: yes</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/BirdOfPrey">
    <rdfs:label xml:lang="en">Bird of Prey</rdfs:label>
    <rdfs:comment xml:lang="en">Predatory bird with sharp talons and hooked beak</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/AvianClass"/>
    <skos:altLabel xml:lang="en">Raptor</skos:altLabel>
    <skos:altLabel xml:lang="en">Predatory Avian</skos:altLabel>
    <skos:altLabel xml:lang="en">Hunter Bird</skos:altLabel>
    <rdfs:comment>feeding: carnivorous</rdfs:comment>
    <rdfs:comment>eyesight: exceptional</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/MajesticEagle">
    <rdfs:label xml:lang="en">Majestic Eagle</rdfs:label>
    <rdfs:comment xml:lang="en">Large raptor with powerful build and impressive wingspan</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/BirdOfPrey"/>
    <skos:altLabel xml:lang="en">Eagle</skos:altLabel>
