    <skos:altLabel xml:lang="en">Flying Squid</skos:altLabel>
    <rdfs:comment>order: Teuthida</rdfs:comment>
    <rdfs:comment>tentacles: ten</rdfs:comment>
    <rdfs:comment>body_type: streamlined</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/SpiralSnail">
    <rdfs:label xml:lang="en">Spiral Snail</rdfs:label>
    <rdfs:comment xml:lang="en">Gastropod with spiral coiled protective shell</rdfs:comment>
