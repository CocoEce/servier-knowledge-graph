    <skos:altLabel xml:lang="en">Beetle</skos:altLabel>
    <skos:altLabel xml:lang="en">Coleoptera</skos:altLabel>
    <skos:altLabel xml:lang="en">Bug</skos:altLabel>
    <rdfs:comment>order: Coleoptera</rdfs:comment>
    <rdfs:comment>forewing: sclerotized</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/EightLeggedArthropod">
    <rdfs:label xml:lang="en">Eight-Legged Arthropod</rdfs:label>
    <rdfs:comment xml:lang="en">Arthropod with four pairs of legs</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/Spineless"/>
    <skos:altLabel xml:lang="en">Arachnid</skos:altLabel>
    <skos:altLabel xml:lang="en">Arachnida</skos:altLabel>
    <skos:altLabel xml:lang="en">Spider-like</skos:altLabel>
    <rdfs:comment>class: Arachnida</rdfs:comment>
    <rdfs:comment>leg_count: eight</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/WebSpider">
    <rdfs:label xml:lang="en">Web Spider</rdfs:label>
    <rdfs:comment xml:lang="en">Arachnid producing silk webs for prey capture</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/EightLeggedArthropod"/>
    <skos:altLabel xml:lang="en">Spider</skos:altLabel>
    <skos:altLabel xml:lang="en">Araneae</skos:altLabel>
    <skos:altLabel xml:lang="en">Araneus</skos:altLabel>
    <rdfs:comment>order: Araneae</rdfs:comment>
    <rdfs:comment>silk_production: yes</rdfs:comment>
    <rdfs:comment>toxin: present</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/StingingScorpion">
    <rdfs:label xml:lang="en">Stinging Scorpion</rdfs:label>
    <rdfs:comment xml:lang="en">Arachnid with segmented tail bearing venomous sting</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/EightLeggedArthropod"/>
    <skos:altLabel xml:lang="en">Scorpion</skos:altLabel>
    <skos:altLabel xml:lang="en">Scorpiones</skos:altLabel>
    <skos:altLabel xml:lang="en">Desert Scorpion</skos:altLabel>
    <rdfs:comment>order: Scorpiones</rdfs:comment>
    <rdfs:comment>appendage: venomous_telson</rdfs:comment>
    <rdfs:comment>claws: yes</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/SoftBodyMollusk">
    <rdfs:label xml:lang="en">Soft-Body Mollusk</rdfs:label>
    <rdfs:comment xml:lang="en">Invertebrate with soft unsegmented body, often with shell</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/Spineless"/>
    <skos:altLabel xml:lang="en">Mollusk</skos:altLabel>
    <skos:altLabel xml:lang="en">Mollusca</skos:altLabel>
    <skos:altLabel xml:lang="en">Shellfish</skos:altLabel>
    <rdfs:comment>phylum: Mollusca</rdfs:comment>
    <rdfs:comment>body_texture: soft</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/EightArmedOctopus">
    <rdfs:label xml:lang="en">Eight-Armed Octopus</rdfs:label>
    <rdfs:comment xml:lang="en">Marine cephalopod with eight flexible tentacles</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-taxonomy-B/SoftBodyMollusk"/>
    <skos:altLabel xml:lang="en">Octopus</skos:altLabel>
    <skos:altLabel xml:lang="en">Octopoda</skos:altLabel>
    <skos:altLabel xml:lang="en">Cuttlefish</skos:altLabel>
    <rdfs:comment>order: Octopoda</rdfs:comment>
    <rdfs:comment>tentacles: eight</rdfs:comment>
    <rdfs:comment>cognition: advanced</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-taxonomy-B/TenArmedSquid">
    <rdfs:label xml:lang="en">Ten-Armed Squid</rdfs:label>
    <rdfs:comment xml:lang="en">Marine cephalopod with elongated body and ten appendages</rdfs:comment>
