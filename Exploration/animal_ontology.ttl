
@prefix : <http://example.org/animal-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AnimalOntology a owl:Ontology ;
    rdfs:label "Animal Ontology"@en ;
    rdfs:comment "A human-readable ontology classifying animals with clear hierarchy, attributes, and individuals."@en .


### Object Properties
:hasHabitat a owl:ObjectProperty ;
    rdfs:domain :Animal ;
    rdfs:range :Habitat ;
    rdfs:label "has habitat"@en .

:eats a owl:ObjectProperty ;
    rdfs:domain :Animal ;
    rdfs:range :Food ;
    rdfs:label "eats"@en .

:hasDietType a owl:ObjectProperty ;
    rdfs:domain :Animal ;
    rdfs:range :DietType ;
    rdfs:label "has diet type"@en .

### Datatype Properties
:averageWeightKg a owl:DatatypeProperty ;
    rdfs:domain :Animal ;
    rdfs:range xsd:float ;
    rdfs:label "average weight (kg)"@en .

:averageLifespanYears a owl:DatatypeProperty ;
    rdfs:domain :Animal ;
    rdfs:range xsd:integer ;
    rdfs:label "average lifespan (years)"@en .


:Animal a owl:Class ;
    rdfs:label "Animal"@en ;
    rdfs:comment "Any multicellular animal."@en .


:Vertebrate a owl:Class ;
    rdfs:label "Vertebrate"@en ;
    rdfs:comment "Animals with a backbone."@en .


:Invertebrate a owl:Class ;
    rdfs:label "Invertebrate"@en ;
    rdfs:comment "Animals without a backbone."@en .


:Mammal a owl:Class ;
    rdfs:label "Mammal"@en ;
    rdfs:comment "Warm-blooded vertebrates with hair and milk production."@en .


:Bird a owl:Class ;
    rdfs:label "Bird"@en ;
    rdfs:comment "Feathered vertebrates that lay eggs."@en .


:Reptile a owl:Class ;
    rdfs:label "Reptile"@en ;
    rdfs:comment "Cold-blooded vertebrates with scales."@en .


:Amphibian a owl:Class ;
    rdfs:label "Amphibian"@en ;
    rdfs:comment "Vertebrates that live both in water and on land."@en .


:Fish a owl:Class ;
    rdfs:label "Fish"@en ;
    rdfs:comment "Aquatic vertebrates with gills."@en .


:Insect a owl:Class ;
    rdfs:label "Insect"@en ;
    rdfs:comment "Six-legged invertebrates."@en .


:Arachnid a owl:Class ;
    rdfs:label "Arachnid"@en ;
    rdfs:comment "Eight-legged invertebrates."@en .


:Habitat a owl:Class ;
    rdfs:label "Habitat"@en ;
    rdfs:comment "Natural living environment."@en .


:DietType a owl:Class ;
    rdfs:label "DietType"@en ;
    rdfs:comment "Type of diet."@en .


:Food a owl:Class ;
    rdfs:label "Food"@en ;
    rdfs:comment "Food consumed by animals."@en .


:Vertebrate rdfs:subClassOf :Animal .
:Invertebrate rdfs:subClassOf :Animal .

:Mammal rdfs:subClassOf :Vertebrate .
:Bird rdfs:subClassOf :Vertebrate .
:Reptile rdfs:subClassOf :Vertebrate .
:Amphibian rdfs:subClassOf :Vertebrate .
:Fish rdfs:subClassOf :Vertebrate .

:Insect rdfs:subClassOf :Invertebrate .
:Arachnid rdfs:subClassOf :Invertebrate .


:Canine a owl:Class ;
    rdfs:subClassOf :Mammal ;
    rdfs:label "Canine"@en ;
    rdfs:comment "A subgroup of mammals."@en .


:Feline a owl:Class ;
    rdfs:subClassOf :Mammal ;
    rdfs:label "Feline"@en ;
    rdfs:comment "A subgroup of mammals."@en .


:Primate a owl:Class ;
    rdfs:subClassOf :Mammal ;
    rdfs:label "Primate"@en ;
    rdfs:comment "A subgroup of mammals."@en .


:Cetacean a owl:Class ;
