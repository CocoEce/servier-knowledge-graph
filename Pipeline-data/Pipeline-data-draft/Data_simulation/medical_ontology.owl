<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/medical#"
     xml:base="http://www.example.org/medical"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.example.org/medical"/>
    
    
    <!-- Classes -->
    
    <owl:Class rdf:about="http://www.example.org/medical#Disease">
        <rdfs:label>Maladie</rdfs:label>
        <rdfs:comment>Une condition médicale ou pathologie</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.example.org/medical#Drug">
        <rdfs:label>Médicament</rdfs:label>
        <rdfs:comment>Une substance utilisée pour traiter ou prévenir une maladie</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.example.org/medical#Symptom">
        <rdfs:label>Symptôme</rdfs:label>
        <rdfs:comment>Une manifestation d'une maladie</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.example.org/medical#Patient">
        <rdfs:label>Patient</rdfs:label>
        <rdfs:comment>Une personne recevant des soins médicaux</rdfs:comment>
    </owl:Class>
    
    
    <!-- Object Properties -->
    
    <owl:ObjectProperty rdf:about="http://www.example.org/medical#treats">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Drug"/>
        <rdfs:range rdf:resource="http://www.example.org/medical#Disease"/>
        <rdfs:label>traite</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.example.org/medical#hasSymptom">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Disease"/>
        <rdfs:range rdf:resource="http://www.example.org/medical#Symptom"/>
        <rdfs:label>a pour symptôme</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.example.org/medical#sufferFrom">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Patient"/>
        <rdfs:range rdf:resource="http://www.example.org/medical#Disease"/>
        <rdfs:label>souffre de</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.example.org/medical#takes">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Patient"/>
        <rdfs:range rdf:resource="http://www.example.org/medical#Drug"/>
        <rdfs:label>prend</rdfs:label>
    </owl:ObjectProperty>
    
    
    <!-- Data Properties -->
    
    <owl:DatatypeProperty rdf:about="http://www.example.org/medical#name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>nom</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://www.example.org/medical#dosage">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Drug"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>dosage</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://www.example.org/medical#age">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>âge</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://www.example.org/medical#severity">
        <rdfs:domain rdf:resource="http://www.example.org/medical#Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>sévérité</rdfs:label>
    </owl:DatatypeProperty>
    
    
    <!-- Instances: Maladies -->
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Diabetes">
        <rdf:type rdf:resource="http://www.example.org/medical#Disease"/>
        <name>Diabète</name>
        <rdfs:comment>Maladie chronique caractérisée par un taux élevé de glucose dans le sang</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Hypertension">
        <rdf:type rdf:resource="http://www.example.org/medical#Disease"/>
        <name>Hypertension</name>
        <rdfs:comment>Pression artérielle élevée</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Asthma">
        <rdf:type rdf:resource="http://www.example.org/medical#Disease"/>
        <name>Asthme</name>
        <rdfs:comment>Maladie respiratoire chronique</rdfs:comment>
    </owl:NamedIndividual>
    
    
    <!-- Instances: Médicaments -->
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Metformin">
        <rdf:type rdf:resource="http://www.example.org/medical#Drug"/>
        <name>Metformine</name>
        <dosage>500mg deux fois par jour</dosage>
        <treats rdf:resource="http://www.example.org/medical#Diabetes"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Lisinopril">
        <rdf:type rdf:resource="http://www.example.org/medical#Drug"/>
        <name>Lisinopril</name>
        <dosage>10mg une fois par jour</dosage>
        <treats rdf:resource="http://www.example.org/medical#Hypertension"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Ventolin">
        <rdf:type rdf:resource="http://www.example.org/medical#Drug"/>
        <name>Ventolin</name>
        <dosage>2 inhalations au besoin</dosage>
        <treats rdf:resource="http://www.example.org/medical#Asthma"/>
    </owl:NamedIndividual>
    
    
    <!-- Instances: Symptômes -->
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Fatigue">
        <rdf:type rdf:resource="http://www.example.org/medical#Symptom"/>
        <name>Fatigue</name>
        <severity>Modérée</severity>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Headache">
        <rdf:type rdf:resource="http://www.example.org/medical#Symptom"/>
        <name>Mal de tête</name>
        <severity>Légère</severity>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Wheezing">
        <rdf:type rdf:resource="http://www.example.org/medical#Symptom"/>
        <name>Respiration sifflante</name>
        <severity>Sévère</severity>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#ThirstExcessive">
        <rdf:type rdf:resource="http://www.example.org/medical#Symptom"/>
        <name>Soif excessive</name>
        <severity>Modérée</severity>
    </owl:NamedIndividual>
    
    
    <!-- Relations Maladies-Symptômes -->
    
    <rdf:Description rdf:about="http://www.example.org/medical#Diabetes">
        <hasSymptom rdf:resource="http://www.example.org/medical#Fatigue"/>
        <hasSymptom rdf:resource="http://www.example.org/medical#ThirstExcessive"/>
    </rdf:Description>
    
    <rdf:Description rdf:about="http://www.example.org/medical#Hypertension">
        <hasSymptom rdf:resource="http://www.example.org/medical#Headache"/>
    </rdf:Description>
    
    <rdf:Description rdf:about="http://www.example.org/medical#Asthma">
        <hasSymptom rdf:resource="http://www.example.org/medical#Wheezing"/>
    </rdf:Description>
    
    
    <!-- Instances: Patients -->
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Patient001">
        <rdf:type rdf:resource="http://www.example.org/medical#Patient"/>
        <name>Marie Dupont</name>
        <age rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</age>
        <sufferFrom rdf:resource="http://www.example.org/medical#Diabetes"/>
        <takes rdf:resource="http://www.example.org/medical#Metformin"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Patient002">
        <rdf:type rdf:resource="http://www.example.org/medical#Patient"/>
        <name>Jean Martin</name>
        <age rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">62</age>
        <sufferFrom rdf:resource="http://www.example.org/medical#Hypertension"/>
        <takes rdf:resource="http://www.example.org/medical#Lisinopril"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="http://www.example.org/medical#Patient003">
        <rdf:type rdf:resource="http://www.example.org/medical#Patient"/>
        <name>Sophie Bernard</name>
        <age rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</age>
        <sufferFrom rdf:resource="http://www.example.org/medical#Asthma"/>
        <takes rdf:resource="http://www.example.org/medical#Ventolin"/>
    </owl:NamedIndividual>

</rdf:RDF>
