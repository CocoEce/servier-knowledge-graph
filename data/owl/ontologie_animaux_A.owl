<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns="http://example.org/animal-ontology-A#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xml:base="http://example.org/animal-ontology-A">
  <owl:Ontology rdf:about="http://example.org/animal-ontology-A">
    <owl:versionInfo>1.0</owl:versionInfo>
    <dc:title>Animal Taxonomy Ontology A</dc:title>
    <dc:description>A comprehensive ontology of animal species with hierarchical classification</dc:description>
    <dc:created>2026-01-22T11:47:52.901160</dc:created>
  </owl:Ontology>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Animal">
    <rdfs:label xml:lang="en">Animal</rdfs:label>
    <rdfs:comment xml:lang="en">A living organism that feeds on organic matter, typically having specialized sense organs and nervous system</rdfs:comment>
    <skos:altLabel xml:lang="en">Animalia</skos:altLabel>
    <skos:altLabel xml:lang="en">Metazoa</skos:altLabel>
    <skos:altLabel xml:lang="en">Fauna</skos:altLabel>
    <rdfs:comment>kingdom: Animalia</rdfs:comment>
    <rdfs:comment>type: root_class</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Mammal">
    <rdfs:label xml:lang="en">Mammal</rdfs:label>
    <rdfs:comment xml:lang="en">Warm-blooded vertebrate animal characterized by hair or fur and mammary glands</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Animal"/>
    <skos:altLabel xml:lang="en">Mammalia</skos:altLabel>
    <skos:altLabel xml:lang="en">Mammalian</skos:altLabel>
    <rdfs:comment>class: Mammalia</rdfs:comment>
    <rdfs:comment>body_temperature: warm-blooded</rdfs:comment>
    <rdfs:comment>reproduction: viviparous</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Carnivore">
    <rdfs:label xml:lang="en">Carnivore</rdfs:label>
    <rdfs:comment xml:lang="en">Mammal that primarily feeds on flesh</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Mammal"/>
    <skos:altLabel xml:lang="en">Carnivora</skos:altLabel>
    <skos:altLabel xml:lang="en">Meat-eater</skos:altLabel>
    <skos:altLabel xml:lang="en">Predatory Mammal</skos:altLabel>
    <rdfs:comment>order: Carnivora</rdfs:comment>
    <rdfs:comment>diet: carnivorous</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Felidae">
    <rdfs:label xml:lang="en">Felidae</rdfs:label>
    <rdfs:comment xml:lang="en">Family of carnivorous mammals commonly known as cats</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Carnivore"/>
    <skos:altLabel xml:lang="en">Cat Family</skos:altLabel>
    <skos:altLabel xml:lang="en">Felines</skos:altLabel>
    <skos:altLabel xml:lang="en">Cats</skos:altLabel>
    <rdfs:comment>family: Felidae</rdfs:comment>
    <rdfs:comment>characteristics: retractable_claws</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Lion">
    <rdfs:label xml:lang="en">Lion</rdfs:label>
    <rdfs:comment xml:lang="en">Large tawny-colored cat that lives in prides</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Felidae"/>
    <skos:altLabel xml:lang="en">Panthera leo</skos:altLabel>
    <skos:altLabel xml:lang="en">King of the Jungle</skos:altLabel>
    <skos:altLabel xml:lang="en">African Lion</skos:altLabel>
    <rdfs:comment>species: Panthera leo</rdfs:comment>
    <rdfs:comment>habitat: savanna</rdfs:comment>
    <rdfs:comment>conservation_status: vulnerable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Tiger">
    <rdfs:label xml:lang="en">Tiger</rdfs:label>
    <rdfs:comment xml:lang="en">Largest cat species with distinctive orange coat and black stripes</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Felidae"/>
    <skos:altLabel xml:lang="en">Panthera tigris</skos:altLabel>
    <skos:altLabel xml:lang="en">Bengal Tiger</skos:altLabel>
    <skos:altLabel xml:lang="en">Striped Cat</skos:altLabel>
    <rdfs:comment>species: Panthera tigris</rdfs:comment>
    <rdfs:comment>habitat: forest</rdfs:comment>
    <rdfs:comment>conservation_status: endangered</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Leopard">
    <rdfs:label xml:lang="en">Leopard</rdfs:label>
    <rdfs:comment xml:lang="en">Large cat with spotted coat found in Africa and Asia</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Felidae"/>
    <skos:altLabel xml:lang="en">Panthera pardus</skos:altLabel>
    <skos:altLabel xml:lang="en">Spotted Cat</skos:altLabel>
    <skos:altLabel xml:lang="en">Panther</skos:altLabel>
    <rdfs:comment>species: Panthera pardus</rdfs:comment>
    <rdfs:comment>habitat: various</rdfs:comment>
    <rdfs:comment>conservation_status: vulnerable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Cheetah">
    <rdfs:label xml:lang="en">Cheetah</rdfs:label>
    <rdfs:comment xml:lang="en">Fastest land animal with distinctive black tear marks</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Felidae"/>
    <skos:altLabel xml:lang="en">Acinonyx jubatus</skos:altLabel>
    <skos:altLabel xml:lang="en">Hunting Leopard</skos:altLabel>
    <skos:altLabel xml:lang="en">Speed Cat</skos:altLabel>
    <rdfs:comment>species: Acinonyx jubatus</rdfs:comment>
    <rdfs:comment>habitat: grassland</rdfs:comment>
    <rdfs:comment>max_speed: 120 km/h</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/DomesticCat">
    <rdfs:label xml:lang="en">Domestic Cat</rdfs:label>
    <rdfs:comment xml:lang="en">Small domesticated carnivorous mammal kept as pet</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Felidae"/>
    <skos:altLabel xml:lang="en">Felis catus</skos:altLabel>
    <skos:altLabel xml:lang="en">House Cat</skos:altLabel>
    <skos:altLabel xml:lang="en">Pet Cat</skos:altLabel>
    <rdfs:comment>species: Felis catus</rdfs:comment>
    <rdfs:comment>habitat: domestic</rdfs:comment>
    <rdfs:comment>status: domesticated</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Canidae">
    <rdfs:label xml:lang="en">Canidae</rdfs:label>
    <rdfs:comment xml:lang="en">Family of carnivorous mammals including dogs, wolves, and foxes</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Carnivore"/>
    <skos:altLabel xml:lang="en">Dog Family</skos:altLabel>
    <skos:altLabel xml:lang="en">Canines</skos:altLabel>
    <rdfs:comment>family: Canidae</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Wolf">
    <rdfs:label xml:lang="en">Wolf</rdfs:label>
    <rdfs:comment xml:lang="en">Large canine native to wilderness areas</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Canidae"/>
    <skos:altLabel xml:lang="en">Canis lupus</skos:altLabel>
    <skos:altLabel xml:lang="en">Gray Wolf</skos:altLabel>
    <skos:altLabel xml:lang="en">Timber Wolf</skos:altLabel>
    <rdfs:comment>species: Canis lupus</rdfs:comment>
    <rdfs:comment>habitat: forest</rdfs:comment>
    <rdfs:comment>social: pack animal</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Dog">
    <rdfs:label xml:lang="en">Dog</rdfs:label>
    <rdfs:comment xml:lang="en">Domesticated carnivorous mammal descended from wolves</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Canidae"/>
    <skos:altLabel xml:lang="en">Canis familiaris</skos:altLabel>
    <skos:altLabel xml:lang="en">Domestic Dog</skos:altLabel>
    <skos:altLabel xml:lang="en">Canine</skos:altLabel>
    <rdfs:comment>species: Canis familiaris</rdfs:comment>
    <rdfs:comment>habitat: domestic</rdfs:comment>
    <rdfs:comment>status: domesticated</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Fox">
    <rdfs:label xml:lang="en">Fox</rdfs:label>
    <rdfs:comment xml:lang="en">Small to medium-sized omnivorous mammal with bushy tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Canidae"/>
    <skos:altLabel xml:lang="en">Vulpes</skos:altLabel>
    <skos:altLabel xml:lang="en">Red Fox</skos:altLabel>
    <skos:altLabel xml:lang="en">Kit Fox</skos:altLabel>
    <rdfs:comment>genus: Vulpes</rdfs:comment>
    <rdfs:comment>habitat: various</rdfs:comment>
    <rdfs:comment>diet: omnivorous</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Ursidae">
    <rdfs:label xml:lang="en">Ursidae</rdfs:label>
    <rdfs:comment xml:lang="en">Family of large carnivorous or omnivorous mammals known as bears</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Carnivore"/>
    <skos:altLabel xml:lang="en">Bear Family</skos:altLabel>
    <skos:altLabel xml:lang="en">Bears</skos:altLabel>
    <rdfs:comment>family: Ursidae</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/BrownBear">
    <rdfs:label xml:lang="en">Brown Bear</rdfs:label>
    <rdfs:comment xml:lang="en">Large bear species found across North America and Eurasia</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Ursidae"/>
    <skos:altLabel xml:lang="en">Ursus arctos</skos:altLabel>
    <skos:altLabel xml:lang="en">Grizzly Bear</skos:altLabel>
    <skos:altLabel xml:lang="en">Kodiak Bear</skos:altLabel>
    <rdfs:comment>species: Ursus arctos</rdfs:comment>
    <rdfs:comment>habitat: forest</rdfs:comment>
    <rdfs:comment>size: large</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/PolarBear">
    <rdfs:label xml:lang="en">Polar Bear</rdfs:label>
    <rdfs:comment xml:lang="en">Large white bear native to Arctic regions</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Ursidae"/>
    <skos:altLabel xml:lang="en">Ursus maritimus</skos:altLabel>
    <skos:altLabel xml:lang="en">Ice Bear</skos:altLabel>
    <skos:altLabel xml:lang="en">Arctic Bear</skos:altLabel>
    <rdfs:comment>species: Ursus maritimus</rdfs:comment>
    <rdfs:comment>habitat: arctic</rdfs:comment>
    <rdfs:comment>conservation_status: vulnerable</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Primate">
    <rdfs:label xml:lang="en">Primate</rdfs:label>
    <rdfs:comment xml:lang="en">Mammal of an order that includes monkeys, apes, and humans</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Mammal"/>
    <skos:altLabel xml:lang="en">Primates</skos:altLabel>
    <skos:altLabel xml:lang="en">Simian</skos:altLabel>
    <rdfs:comment>order: Primates</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Ape">
    <rdfs:label xml:lang="en">Ape</rdfs:label>
    <rdfs:comment xml:lang="en">Large tailless primate including gorillas, chimpanzees, and orangutans</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Primate"/>
    <skos:altLabel xml:lang="en">Great Ape</skos:altLabel>
    <skos:altLabel xml:lang="en">Hominoidea</skos:altLabel>
    <rdfs:comment>superfamily: Hominoidea</rdfs:comment>
    <rdfs:comment>tail: absent</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Gorilla">
    <rdfs:label xml:lang="en">Gorilla</rdfs:label>
    <rdfs:comment xml:lang="en">Largest living primate native to African forests</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Ape"/>
    <skos:altLabel xml:lang="en">Gorilla gorilla</skos:altLabel>
    <skos:altLabel xml:lang="en">Mountain Gorilla</skos:altLabel>
    <skos:altLabel xml:lang="en">Silverback</skos:altLabel>
    <rdfs:comment>genus: Gorilla</rdfs:comment>
    <rdfs:comment>habitat: forest</rdfs:comment>
    <rdfs:comment>conservation_status: endangered</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Chimpanzee">
    <rdfs:label xml:lang="en">Chimpanzee</rdfs:label>
    <rdfs:comment xml:lang="en">Great ape species native to Africa, closely related to humans</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Ape"/>
    <skos:altLabel xml:lang="en">Pan troglodytes</skos:altLabel>
    <skos:altLabel xml:lang="en">Common Chimp</skos:altLabel>
    <skos:altLabel xml:lang="en">Chimp</skos:altLabel>
    <rdfs:comment>species: Pan troglodytes</rdfs:comment>
    <rdfs:comment>habitat: forest</rdfs:comment>
    <rdfs:comment>intelligence: high</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Orangutan">
    <rdfs:label xml:lang="en">Orangutan</rdfs:label>
    <rdfs:comment xml:lang="en">Large arboreal ape with reddish-brown hair native to Indonesia</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Ape"/>
    <skos:altLabel xml:lang="en">Pongo</skos:altLabel>
    <skos:altLabel xml:lang="en">Red Ape</skos:altLabel>
    <skos:altLabel xml:lang="en">Man of the Forest</skos:altLabel>
    <rdfs:comment>genus: Pongo</rdfs:comment>
    <rdfs:comment>habitat: rainforest</rdfs:comment>
    <rdfs:comment>conservation_status: critically_endangered</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Monkey">
    <rdfs:label xml:lang="en">Monkey</rdfs:label>
    <rdfs:comment xml:lang="en">Primate with tails, generally smaller than apes</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Primate"/>
    <skos:altLabel xml:lang="en">Simian</skos:altLabel>
    <skos:altLabel xml:lang="en">Cercopithecoidea</skos:altLabel>
    <rdfs:comment>tail: present</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Rodent">
    <rdfs:label xml:lang="en">Rodent</rdfs:label>
    <rdfs:comment xml:lang="en">Mammal characterized by continuously growing incisors</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Mammal"/>
    <skos:altLabel xml:lang="en">Rodentia</skos:altLabel>
    <skos:altLabel xml:lang="en">Gnawing Mammal</skos:altLabel>
    <rdfs:comment>order: Rodentia</rdfs:comment>
    <rdfs:comment>teeth: continuously_growing_incisors</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Mouse">
    <rdfs:label xml:lang="en">Mouse</rdfs:label>
    <rdfs:comment xml:lang="en">Small rodent with pointed snout and long tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Rodent"/>
    <skos:altLabel xml:lang="en">Mus</skos:altLabel>
    <skos:altLabel xml:lang="en">House Mouse</skos:altLabel>
    <skos:altLabel xml:lang="en">Field Mouse</skos:altLabel>
    <rdfs:comment>genus: Mus</rdfs:comment>
    <rdfs:comment>size: small</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Rat">
    <rdfs:label xml:lang="en">Rat</rdfs:label>
    <rdfs:comment xml:lang="en">Medium-sized rodent with long tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Rodent"/>
    <skos:altLabel xml:lang="en">Rattus</skos:altLabel>
    <skos:altLabel xml:lang="en">Brown Rat</skos:altLabel>
    <skos:altLabel xml:lang="en">Norway Rat</skos:altLabel>
    <rdfs:comment>genus: Rattus</rdfs:comment>
    <rdfs:comment>size: medium</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Squirrel">
    <rdfs:label xml:lang="en">Squirrel</rdfs:label>
    <rdfs:comment xml:lang="en">Arboreal rodent with bushy tail</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Rodent"/>
    <skos:altLabel xml:lang="en">Sciurus</skos:altLabel>
    <skos:altLabel xml:lang="en">Tree Squirrel</skos:altLabel>
    <skos:altLabel xml:lang="en">Ground Squirrel</skos:altLabel>
    <rdfs:comment>family: Sciuridae</rdfs:comment>
    <rdfs:comment>habitat: trees</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Cetacean">
    <rdfs:label xml:lang="en">Cetacean</rdfs:label>
    <rdfs:comment xml:lang="en">Aquatic mammal including whales, dolphins, and porpoises</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Mammal"/>
    <skos:altLabel xml:lang="en">Cetacea</skos:altLabel>
    <skos:altLabel xml:lang="en">Marine Mammal</skos:altLabel>
    <skos:altLabel xml:lang="en">Whale</skos:altLabel>
    <rdfs:comment>order: Cetacea</rdfs:comment>
    <rdfs:comment>habitat: marine</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Dolphin">
    <rdfs:label xml:lang="en">Dolphin</rdfs:label>
    <rdfs:comment xml:lang="en">Highly intelligent marine mammal with streamlined body</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Cetacean"/>
    <skos:altLabel xml:lang="en">Delphinidae</skos:altLabel>
    <skos:altLabel xml:lang="en">Bottlenose Dolphin</skos:altLabel>
    <skos:altLabel xml:lang="en">Porpoise</skos:altLabel>
    <rdfs:comment>family: Delphinidae</rdfs:comment>
    <rdfs:comment>intelligence: high</rdfs:comment>
    <rdfs:comment>echolocation: yes</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Whale">
    <rdfs:label xml:lang="en">Whale</rdfs:label>
    <rdfs:comment xml:lang="en">Large marine mammal with streamlined body</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Cetacean"/>
    <skos:altLabel xml:lang="en">Balaenopteridae</skos:altLabel>
    <skos:altLabel xml:lang="en">Blue Whale</skos:altLabel>
    <skos:altLabel xml:lang="en">Humpback Whale</skos:altLabel>
    <rdfs:comment>size: very_large</rdfs:comment>
    <rdfs:comment>habitat: ocean</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Bird">
    <rdfs:label xml:lang="en">Bird</rdfs:label>
    <rdfs:comment xml:lang="en">Warm-blooded vertebrate with feathers, wings, and beak</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Animal"/>
    <skos:altLabel xml:lang="en">Aves</skos:altLabel>
    <skos:altLabel xml:lang="en">Avian</skos:altLabel>
    <skos:altLabel xml:lang="en">Feathered Animal</skos:altLabel>
    <rdfs:comment>class: Aves</rdfs:comment>
    <rdfs:comment>body_covering: feathers</rdfs:comment>
    <rdfs:comment>reproduction: oviparous</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/RaptorBird">
    <rdfs:label xml:lang="en">Raptor</rdfs:label>
    <rdfs:comment xml:lang="en">Bird of prey with strong talons and keen eyesight</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/Bird"/>
    <skos:altLabel xml:lang="en">Bird of Prey</skos:altLabel>
    <skos:altLabel xml:lang="en">Predatory Bird</skos:altLabel>
    <skos:altLabel xml:lang="en">Raptor</skos:altLabel>
    <rdfs:comment>diet: carnivorous</rdfs:comment>
    <rdfs:comment>vision: excellent</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Eagle">
    <rdfs:label xml:lang="en">Eagle</rdfs:label>
    <rdfs:comment xml:lang="en">Large bird of prey with powerful build and heavy beak</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/RaptorBird"/>
    <skos:altLabel xml:lang="en">Aquila</skos:altLabel>
    <skos:altLabel xml:lang="en">Bald Eagle</skos:altLabel>
    <skos:altLabel xml:lang="en">Golden Eagle</skos:altLabel>
    <rdfs:comment>genus: Aquila</rdfs:comment>
    <rdfs:comment>wingspan: large</rdfs:comment>
    <rdfs:comment>habitat: mountains</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/animal-ontology-A/Hawk">
    <rdfs:label xml:lang="en">Hawk</rdfs:label>
    <rdfs:comment xml:lang="en">Medium-sized bird of prey with broad wings</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/animal-ontology-A/RaptorBird"/>
    <skos:altLabel xml:lang="en">Accipiter</skos:altLabel>
