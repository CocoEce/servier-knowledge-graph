@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix chebi: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix pubchem: <http://rdf.ncbi.nlm.nih.gov/pubchem/compound/CID> .
@prefix wd: <http://www.wikidata.org/entity/> .

@base <urn:webprotege:ontology:75584b1c-4072-4754-87de-8a723b68c177> .

<urn:webprotege:ontology:75584b1c-4072-4754-87de-8a723b68c177>
    rdf:type owl:Ontology .

#################################################################
# Annotation properties
#################################################################

skos:altLabel rdf:type owl:AnnotationProperty .
skos:prefLabel rdf:type owl:AnnotationProperty .
skos:exactMatch rdf:type owl:ObjectProperty .

#################################################################
# Classes
#################################################################

<http://webprotege.stanford.edu/R9LuOGlUe4X88gj5UkigsqB>
    rdf:type owl:Class ;
    rdfs:label "CanonicalChemical" .

